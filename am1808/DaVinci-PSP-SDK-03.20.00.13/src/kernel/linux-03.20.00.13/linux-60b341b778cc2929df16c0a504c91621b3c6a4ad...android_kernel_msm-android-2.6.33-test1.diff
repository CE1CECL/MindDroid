--- linux-60b341b778cc2929df16c0a504c91621b3c6a4ad/drivers/misc/uid_stat.c	1969-12-31 19:00:00.000000000 -0500
+++ android_kernel_msm-android-2.6.33-test1/drivers/misc/uid_stat.c	2010-03-01 18:58:02.000000000 -0500
@@ -0,0 +1,153 @@
+/* drivers/misc/uid_stat.c
+ *
+ * Copyright (C) 2008 - 2009 Google, Inc.
+ *
+ * This software is licensed under the terms of the GNU General Public
+ * License version 2, as published by the Free Software Foundation, and

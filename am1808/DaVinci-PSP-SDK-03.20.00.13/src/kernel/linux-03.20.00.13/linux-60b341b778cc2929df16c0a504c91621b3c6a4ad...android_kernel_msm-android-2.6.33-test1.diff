diff -aprNu linux-60b341b778cc2929df16c0a504c91621b3c6a4ad/drivers/char/dcc_tty.c android_kernel_msm-android-2.6.33-test1/drivers/char/dcc_tty.c
--- linux-60b341b778cc2929df16c0a504c91621b3c6a4ad/drivers/char/dcc_tty.c	1969-12-31 19:00:00.000000000 -0500
+++ android_kernel_msm-android-2.6.33-test1/drivers/char/dcc_tty.c	2010-03-01 18:58:02.000000000 -0500

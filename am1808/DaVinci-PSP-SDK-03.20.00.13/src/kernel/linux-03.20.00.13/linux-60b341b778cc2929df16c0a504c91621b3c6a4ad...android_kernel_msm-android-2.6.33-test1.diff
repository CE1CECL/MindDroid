diff -aprNu linux-60b341b778cc2929df16c0a504c91621b3c6a4ad/drivers/rtc/alarm.c android_kernel_msm-android-2.6.33-test1/drivers/rtc/alarm.c
--- linux-60b341b778cc2929df16c0a504c91621b3c6a4ad/drivers/rtc/alarm.c	1969-12-31 19:00:00.000000000 -0500
